+def test_execution_metadata_key_normalization_handles_punctuation_and_camel_case() -> None:
+    sql = MIGRATION.read_text(encoding="utf-8")
+
+    assert "regexp_replace" in sql
+    assert "([A-Z]+)([A-Z][a-z])" in sql
+    assert "([a-z0-9])([A-Z])" in sql
+    assert "[^A-Za-z0-9]+" in sql
+    assert "v_seen text[]" in sql
+    assert "v_compact text" in sql
+    assert "replace(v_normalized, '_', '')" in sql
+    assert "v_normalized = ANY(v_seen)" in sql
